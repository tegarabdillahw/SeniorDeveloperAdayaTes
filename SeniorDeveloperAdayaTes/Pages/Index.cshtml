@page
@{
    ViewData["Title"] = "Order Management";
}
<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Order Management</title>
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <header class="topbar">
        <div>
            <h1>Order Management</h1>
            <p>ASP.NET Core Web App .NET 7</p>
        </div>
        <a class="btn primary" href="/ui/orders/create">+ Create Order</a>
    </header>

    <main class="container">
        <section class="card">
            <div class="section-title">
                <div>
                    <h2>Daftar Order</h2>
                    <p>Filter sederhana berdasarkan status dan customer.</p>
                </div>
            </div>

            <div class="filters">
                <div class="field">
                    <label>Status</label>
                    <select id="status">
                        <option value="">Semua Status</option>
                        <option value="Pending">Pending</option>
                        <option value="Confirmed">Confirmed</option>
                        <option value="Shipped">Shipped</option>
                        <option value="Delivered">Delivered</option>
                        <option value="Cancelled">Cancelled</option>
                    </select>
                </div>
                <div class="field">
                    <label>Customer ID</label>
                    <input id="customerId" type="number" min="1" placeholder="Contoh: 1001" />
                </div>
                <div class="field button-field">
                    <label>&nbsp;</label>
                    <button class="btn" onclick="loadOrders(1)">Cari</button>
                </div>
            </div>

            <div id="message" class="message hidden"></div>

            <div class="table-wrap">
                <table>
                    <thead>
                        <tr>
                            <th>Order ID</th>
                            <th>Customer</th>
                            <th>Alamat</th>
                            <th>Status</th>
                            <th>Total</th>
                            <th>Aksi</th>
                        </tr>
                    </thead>
                    <tbody id="orderRows">
                        <tr><td colspan="6" class="empty">Memuat data...</td></tr>
                    </tbody>
                </table>
            </div>

            <div class="pagination">
                <button id="prevBtn" class="btn" onclick="prevPage()">Sebelumnya</button>
                <span id="pageInfo">Page 1</span>
                <button id="nextBtn" class="btn" onclick="nextPage()">Berikutnya</button>
            </div>
        </section>
    </main>

    <script>
        let currentPage = 1;
        let totalPages = 0;
        const pageSize = 10;

        function rupiah(value) {
            return new Intl.NumberFormat('id-ID', {
                style: 'currency',
                currency: 'IDR',
                maximumFractionDigits: 0
            }).format(value || 0);
        }

        async function loadOrders(page) {
            currentPage = page;

            const status = document.getElementById('status').value;
            const customerId = document.getElementById('customerId').value;

            const params = new URLSearchParams();
            if (status) params.append('status', status);
            if (customerId) params.append('customerId', customerId);
            params.append('page', currentPage);
            params.append('pageSize', pageSize);

            const tbody = document.getElementById('orderRows');
            tbody.innerHTML = '<tr><td colspan="6" class="empty">Memuat data...</td></tr>';
            hideMessage();

            try {
                const response = await fetch(`/orders?${params.toString()}`);
                const result = await response.json();

                if (!response.ok) {
                    showMessage(result.message || 'Gagal mengambil data.', 'error');
                    tbody.innerHTML = '<tr><td colspan="6" class="empty">Data tidak dapat dimuat.</td></tr>';
                    return;
                }

                totalPages = result.totalPages;
                renderRows(result.data);
                updatePagination(result.page, result.totalPages);
            } catch {
                showMessage('Tidak dapat terhubung ke server.', 'error');
            }
        }

        function renderRows(data) {
            const tbody = document.getElementById('orderRows');

            if (!data || data.length === 0) {
                tbody.innerHTML = '<tr><td colspan="6" class="empty">Belum ada order yang sesuai.</td></tr>';
                return;
            }

            tbody.innerHTML = data.map(order => `
                <tr>
                    <td class="mono">${order.id}</td>
                    <td>${order.customerId}</td>
                    <td>${escapeHtml(order.shippingAddress)}</td>
                    <td><span class="status ${order.status.toLowerCase()}">${order.status}</span></td>
                    <td>${rupiah(order.totalAmount)}</td>
                    <td><a class="btn small" href="/ui/orders/${order.id}">Detail</a></td>
                </tr>
            `).join('');
        }

        function updatePagination(page, pages) {
            document.getElementById('pageInfo').textContent = `Page ${page} dari ${pages || 0}`;
            document.getElementById('prevBtn').disabled = page <= 1;
            document.getElementById('nextBtn').disabled = pages === 0 || page >= pages;
        }

        function prevPage() {
            if (currentPage > 1) loadOrders(currentPage - 1);
        }

        function nextPage() {
            if (currentPage < totalPages) loadOrders(currentPage + 1);
        }

        function showMessage(text, type) {
            const el = document.getElementById('message');
            el.className = `message ${type}`;
            el.textContent = text;
        }

        function hideMessage() {
            const el = document.getElementById('message');
            el.className = 'message hidden';
            el.textContent = '';
        }

        function escapeHtml(value) {
            const div = document.createElement('div');
            div.textContent = value ?? '';
            return div.innerHTML;
        }

        loadOrders(1);
    </script>
</body>
</html>
