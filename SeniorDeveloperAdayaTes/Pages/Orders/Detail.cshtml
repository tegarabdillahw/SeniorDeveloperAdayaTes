@page "/ui/orders/{id:guid}"
<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Order Detail</title>
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <header class="topbar">
        <div>
            <h1>Order Detail</h1>
            <p>Lihat detail dan proses status order.</p>
        </div>
        <a class="btn" href="/">Kembali</a>
    </header>

    <main class="container">
        <div id="message" class="message hidden"></div>

        <section id="detailCard" class="card">
            <div class="empty">Memuat order...</div>
        </section>
    </main>

    <script>
        const orderId = window.location.pathname.split('/').pop();
        let currentOrder = null;

        function rupiah(value) {
            return new Intl.NumberFormat('id-ID', {
                style: 'currency',
                currency: 'IDR',
                maximumFractionDigits: 0
            }).format(value || 0);
        }

        function dateText(value) {
            return value ? new Date(value).toLocaleString('id-ID') : '-';
        }

        async function loadOrder() {
            hideMessage();

            try {
                const response = await fetch(`/orders/${orderId}`);
                const result = await response.json();

                if (!response.ok) {
                    showMessage(result.message || 'Order tidak ditemukan.', 'error');
                    document.getElementById('detailCard').innerHTML = '';
                    return;
                }

                currentOrder = result;
                renderOrder(result);
            } catch {
                showMessage('Tidak dapat terhubung ke server.', 'error');
            }
        }

        function renderOrder(order) {
            const items = order.items.map(item => `
                <tr>
                    <td>${item.productId}</td>
                    <td>${escapeHtml(item.productName)}</td>
                    <td>${item.quantity}</td>
                    <td>${rupiah(item.unitPrice)}</td>
                    <td>${rupiah(item.subtotal)}</td>
                </tr>
            `).join('');

            document.getElementById('detailCard').innerHTML = `
                <div class="detail-grid">
                    <div><span class="label">Order ID</span><strong class="mono">${order.id}</strong></div>
                    <div><span class="label">Customer ID</span><strong>${order.customerId}</strong></div>
                    <div><span class="label">Status</span><span class="status ${order.status.toLowerCase()}">${order.status}</span></div>
                    <div><span class="label">Created</span><strong>${dateText(order.createdAtUtc)}</strong></div>
                    <div class="full"><span class="label">Shipping Address</span><strong>${escapeHtml(order.shippingAddress)}</strong></div>
                </div>

                <h2 class="top-gap">Items</h2>
                <div class="table-wrap">
                    <table>
                        <thead>
                            <tr>
                                <th>Product ID</th>
                                <th>Product</th>
                                <th>Qty</th>
                                <th>Harga</th>
                                <th>Subtotal</th>
                            </tr>
                        </thead>
                        <tbody>${items}</tbody>
                        <tfoot>
                            <tr>
                                <th colspan="4">Total</th>
                                <th>${rupiah(order.totalAmount)}</th>
                            </tr>
                        </tfoot>
                    </table>
                </div>

                <div class="actions top-gap" id="statusActions">
                    ${buildActions(order.status)}
                </div>
            `;
        }

        function buildActions(status) {
            if (status === 'Pending') {
                return `
                    <button class="btn primary" onclick="updateStatus('Confirmed')">Confirm</button>
                    <button class="btn danger" onclick="cancelOrder()">Cancel</button>
                `;
            }

            if (status === 'Confirmed') {
                return `
                    <button class="btn primary" onclick="updateStatus('Shipped')">Ship</button>
                    <button class="btn danger" onclick="cancelOrder()">Cancel</button>
                `;
            }

            if (status === 'Shipped') {
                return `<button class="btn primary" onclick="updateStatus('Delivered')">Delivered</button>`;
            }

            return '<span class="muted">Order sudah berada pada status akhir.</span>';
        }

        async function updateStatus(status) {
            if (!confirm(`Ubah status menjadi ${status}?`)) return;

            const response = await fetch(`/orders/${orderId}/status`, {
                method: 'PATCH',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ status })
            });

            const result = await response.json();

            if (!response.ok) {
                showMessage(result.message || 'Gagal update status.', 'error');
                return;
            }

            showMessage(`Status berhasil diubah menjadi ${result.status}.`, 'success');
            currentOrder = result;
            renderOrder(result);
        }

        async function cancelOrder() {
            if (!confirm('Yakin ingin cancel order ini? Stock akan dikembalikan.')) return;

            const response = await fetch(`/orders/${orderId}/cancel`, {
                method: 'POST'
            });

            const result = await response.json();

            if (!response.ok) {
                showMessage(result.message || 'Gagal cancel order.', 'error');
                return;
            }

            showMessage('Order berhasil dibatalkan dan stock dikembalikan.', 'success');
            currentOrder = result;
            renderOrder(result);
        }

        function showMessage(text, type) {
            const el = document.getElementById('message');
            el.className = `message ${type}`;
            el.textContent = text;
        }

        function hideMessage() {
            const el = document.getElementById('message');
            el.className = 'message hidden';
            el.textContent = '';
        }

        function escapeHtml(value) {
            const div = document.createElement('div');
            div.textContent = value ?? '';
            return div.innerHTML;
        }

        loadOrder();
    </script>
</body>
</html>
